      svg: `<svg viewBox="0 0 120 120" fill="none"><path d="M28 45 Q28 85 50 85 Q72 85 72 45" stroke="#c9a961" stroke-width="1.5" fill="rgba(201,169,97,0.06)"/><ellipse cx="50" cy="45" rx="22" ry="7" fill="rgba(245,230,211,0.15)" stroke="#c9a961" stroke-width="1"/><circle cx="42" cy="40" r="4" fill="rgba(245,230,211,0.1)" stroke="#c9a961" stroke-width="0.5"/><circle cx="55" cy="38" r="5" fill="rgba(245,230,211,0.1)" stroke="#c9a961" stroke-width="0.5"/><circle cx="50" cy="43" r="3" fill="rgba(245,230,211,0.08)" stroke="#c9a961" stroke-width="0.5"/></svg>`
