        <path d="M25 55 Q25 100 70 100 Q115 100 115 55 Z" fill="url(#cupG)"/>
        <path d="M115 62 Q135 62 135 80 Q135 95 115 92" stroke="url(#cupG)" stroke-width="3" fill="none"/>
        <ellipse cx="70" cy="55" rx="45" ry="10" fill="#3d2b1f"/>
        <circle cx="55" cy="50" r="8" fill="#faf3eb"/>
        <circle cx="70" cy="48" r="9" fill="#faf3eb"/>
        <circle cx="85" cy="50" r="8" fill="#faf3eb"/>
        <circle cx="62" cy="54" r="6" fill="#faf3eb"/>
        <circle cx="78" cy="54" r="6" fill="#faf3eb"/>
        <circle cx="60" cy="45" r="0.8" fill="#3d2b1f" opacity="0.6"/>
        <circle cx="75" cy="43" r="0.6" fill="#3d2b1f" opacity="0.5"/>
        <circle cx="68" cy="47" r="0.7" fill="#3d2b1f" opacity="0.5"/>
        <circle cx="80" cy="46" r="0.5" fill="#3d2b1f" opacity="0.4"/>
        <path d="M55 42 Q60 45 65 42 Q70 45 75 42 Q80 45 85 42" stroke="#3d2b1f" stroke-width="0.8" fill="none" opacity="0.7"/>
      </svg>`;
    }
    if (type === 'flatwhite') {
      return `<svg viewBox="0 0 140 140" xmlns="http://www.w3.org/2000/svg">
        ${defs}
        <ellipse cx="70" cy="108" rx="55" ry="6" fill="url(#cupG)" opacity="0.4"/>
        <path d="M20 55 Q20 95 70 95 Q120 95 120 55 Z" fill="url(#cupG)"/>
        <path d="M120 62 Q140 62 140 78 Q140 92 120 90" stroke="url(#cupG)" stroke-width="3" fill="none"/>
        <ellipse cx="70" cy="55" rx="50" ry="11" fill="#f5e6d3"/>
        <ellipse cx="70" cy="53" rx="47" ry="9" fill="#faf3eb"/>
        <path d="M70 45 Q60 50 55 55 Q65 53 70 57 Q75 53 85 55 Q80 50 70 45 Z" fill="rgba(107,39,55,0.35)"/>
        <path d="M70 48 Q63 52 60 55 Q67 54 70 57 Q73 54 80 55 Q77 52 70 48 Z" fill="rgba(107,39,55,0.2)"/>
        <line x1="70" y1="45" x2="70" y2="60" stroke="rgba(107,39,55,0.3)" stroke-width="0.8"/>
      </svg>`;
    }
    if (type === 'affogato') {
      return `<svg viewBox="0 0 140 140" xmlns="http://www.w3.org/2000/svg">
        ${defs}
        <ellipse cx="70" cy="110" rx="52" ry="5" fill="url(#cupG)" opacity="0.4"/>
        <path d="M25 50 Q25 95 70 95 Q115 95 115 50 Z" fill="url(#glassG)" stroke="url(#cupG)" stroke-width="1"/>
        <circle cx="70" cy="55" r="22" fill="#faf3eb"/>
        <circle cx="60" cy="50" r="15" fill="#f5e6d3"/>
        <circle cx="80" cy="50" r="15" fill="#f5e6d3"/>
        <circle cx="70" cy="45" r="14" fill="#faf3eb"/>
        <path d="M55 35 Q70 40 85 35 L82 55 Q70 58 58 55 Z" fill="url(#coffeeG)" opacity="0.7"/>
        <circle cx="65" cy="42" r="1.5" fill="#d4a574"/>
        <circle cx="75" cy="45" r="1" fill="#d4a574"/>
        <circle cx="70" cy="48" r="1.2" fill="#d4a574"/>
        <circle cx="62" cy="50" r="0.8" fill="#d4a574"/>
        <circle cx="78" cy="50" r="0.8" fill="#d4a574"/>
        <path d="M60 30 Q58 20 60 12" stroke="url(#cupG)" stroke-width="1" fill="none" opacity="0.4">
          <animate attributeName="opacity" values="0.4;0.1;0.4" dur="2.5s" repeatCount="indefinite"/>
        </path>
        <path d="M80 30 Q82 20 80 12" stroke="url(#cupG)" stroke-width="1" fill="none" opacity="0.4">
          <animate attributeName="opacity" values="0.3;0.5;0.3" dur="3s" repeatCount="indefinite"/>
        </path>
      </svg>`;
    }
  };

  // Menu Data
  const menuItems = [
    {
      name: "Gold Reserve Espresso",
      price: 6.50,
      desc: "Our signature double-shot espresso with notes of dark chocolate, caramel, and a whisper of smoked oak.",
      category: "hot",
      tag: "Signature",
      color1: "#3d1f24", color2: "#1a0d08",
      svg: cupSvg('espresso')
    },
    {
      name: "Velvet Cappuccino",
      price: 7.00,
      desc: "Silky microfoam meets our house espresso, crowned with hand-poured latte art and a dusting of cocoa.",
      category: "hot",
      tag: "Popular",
      color1: "#2a1810", color2: "#1a0d08",
      svg: cupSvg('cappuccino')
    },
    {
      name: "Noir Cold Brew",
      price: 7.50,
      desc: "Steeped for 24 hours in cold spring water. Incredibly smooth with hints of brown sugar and vanilla bean.",
      category: "cold",
      tag: "",
      color1: "#1a1420", color2: "#0d0a14",
      svg: cupSvg('coldbrew')
    },
    {
      name: "Caramel Macchiato",
      price: 8.00,
      desc: "Layers of vanilla-infused milk, espresso, and our house-made salted caramel. A decadent indulgence.",
      category: "hot",
      tag: "Chef's Pick",
      color1: "#2a1a0d", color2: "#1a0d08",
      svg: cupSvg('caramel')
    },
    {
      name: "Iced Lavender Latte",
      price: 8.50,
      desc: "French lavender syrup, oat milk, and espresso over ice. A floral masterpiece for the adventurous soul.",
      category: "cold",
      tag: "New",
      color1: "#241828", color2: "#140d1a",
      svg: cupSvg('lavender')
    },
    {
      name: "Dark Chocolate Mocha",
      price: 8.50,
      desc: "Belgian dark chocolate melted into steamed milk and espresso, topped with whipped cream and cocoa dust.",
      category: "special",
      tag: "Indulgent",
      color1: "#2a1510", color2: "#1a0d08",
      svg: cupSvg('mocha')
    },
    {
      name: "Flat White",
      price: 6.00,
      desc: "Double ristretto with velvety steamed milk. The perfect balance of strength and smoothness.",
      category: "hot",
      tag: "",
      color1: "#221810", color2: "#1a0d08",
      svg: cupSvg('flatwhite')
    },
    {
      name: "Affogato Royale",
      price: 9.50,
      desc: "Artisan vanilla gelato drowned in a shot of our hottest espresso. Topped with gold leaf flakes.",
      category: "special",
      tag: "Premium",
      color1: "#2a1f10", color2: "#1a0d08",
      svg: cupSvg('affogato')
    }
  ];

  let currentCategory = 'all';
  let currentItem = null;
  let currentSize = 0;

  function renderMenu(category) {
    const grid = document.getElementById('menuGrid');
    const filtered = category === 'all' ? menuItems : menuItems.filter(i => i.category === category);
    grid.innerHTML = '';
    filtered.forEach((item) => {
      const card = document.createElement('div');
      card.className = 'menu-card reveal';
      card.innerHTML = `
        ${item.tag ? `<div class="menu-tag">${item.tag}</div>` : ''}
        <div class="menu-card-img">
          <div class="img-bg" style="background: radial-gradient(ellipse at center, ${item.color1} 0%, ${item.color2} 100%);">
            ${item.svg}
          </div>
        </div>
        <div class="menu-card-body">
          <div class="menu-card-top">
            <div class="menu-card-name">${item.name}</div>
            <div class="menu-card-price">$${item.price.toFixed(2)}</div>
          </div>
          <div class="menu-card-desc">${item.desc}</div>
          <button class="menu-card-btn" onclick="openModal(${menuItems.indexOf(item)})">Order Now</button>
        </div>
      `;
      grid.appendChild(card);
    });
    observeElements();
  }

  function filterMenu(cat, btn) {
    currentCategory = cat;
    document.querySelectorAll('.menu-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    renderMenu(cat);
  }

  function openModal(idx) {
    currentItem = menuItems[idx];
    document.getElementById('modalName').textContent = currentItem.name;
    document.getElementById('modalPrice').textContent = `$${currentItem.price.toFixed(2)}`;
    document.getElementById('modalDesc').textContent = currentItem.desc;
    document.getElementById('sizeS').textContent = `$${currentItem.price.toFixed(2)}`;
    document.getElementById('sizeM').textContent = `$${(currentItem.price + 1).toFixed(2)}`;
    document.getElementById('sizeL').textContent = `$${(currentItem.price + 2).toFixed(2)}`;
    currentSize = 0;
    document.querySelectorAll('.size-btn').forEach((b, i) => b.classList.toggle('active', i === 0));
    document.getElementById('modalOverlay').classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal(e) {
    if (e.target === document.getElementById('modalOverlay')) closeModalDirect();
  }
  function closeModalDirect() {
    document.getElementById('modalOverlay').classList.remove('active');
    document.body.style.overflow = '';
  }

  function selectSize(btn, idx) {
    currentSize = idx;
    document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const price = currentItem.price + idx;
    document.getElementById('modalPrice').textContent = `$${price.toFixed(2)}`;
  }

  function addToOrder() {
    const sizes = ['Small', 'Medium', 'Large'];
    const price = currentItem.price + currentSize;
    closeModalDirect();
    showNotification(`✓ ${sizes[currentSize]} ${currentItem.name} added — $${price.toFixed(2)}`);
  }

  function showNotification(msg) {
    const n = document.getElementById('notification');
    n.textContent = msg;
    n.classList.add('show');
    setTimeout(() => n.classList.remove('show'), 3000);
  }

  function scrollToMenu() {
    document.getElementById('menu').scrollIntoView({ behavior: 'smooth' });
  }

  window.addEventListener('scroll', () => {
    document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 50);
  });

  function toggleMobile() {
    document.getElementById('mobileMenu').classList.toggle('active');
  }

  function observeElements() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal:not(.visible)').forEach(el => observer.observe(el));
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', function() {
    renderMenu('all');
    observeElements();
  });
</script>
</body>
</html>
