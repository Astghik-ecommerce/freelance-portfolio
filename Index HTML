<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NOIR — Luxury Coffee House</title>
<link rel="preconnect" href="https://cdn.jsdelivr.net">
<link href="https://cdn.jsdelivr.net/fontsource/css/playfair-display@latest/latin.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/fontsource/css/inter@latest/latin.css" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --accent: #d4a574;
    --accent-light: #e8c9a8;
    --accent-deep: #b8865a;
    --wine: #6b2737;
    --wine-deep: #4a1a26;
    --dark: #1a1412;
    --dark-2: #221a17;
    --dark-3: #2a1f1c;
    --cream: #f5e6d3;
    --cream-2: #faf3eb;
    --brown: #3d2b1f;
    --text: #ede3d6;
    --text-dim: #9a8a7a;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Inter', sans-serif;
    background: var(--dark);
    color: var(--text);
    overflow-x: hidden;
  }

  h1, h2, h3, h4 { font-family: 'Playfair Display', serif; }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.2rem 4%;
    background: rgba(26,20,18,0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(212,165,116,0.12);
    transition: all 0.4s;
  }
  nav.scrolled { padding: 0.8rem 4%; background: rgba(26,20,18,0.95); }

  .logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem; font-weight: 700;
    color: var(--accent);
    letter-spacing: 4px;
    cursor: pointer;
  }
  .logo span { color: var(--cream); font-weight: 300; }

  .nav-links { display: flex; gap: 2.5rem; list-style: none; }
  .nav-links a {
    color: var(--text-dim); text-decoration: none;
    font-size: 0.85rem; letter-spacing: 2px; text-transform: uppercase;
    transition: color 0.3s; position: relative;
  }
  .nav-links a::after {
    content: ''; position: absolute; bottom: -4px; left: 0;
    width: 0; height: 1px; background: var(--accent);
    transition: width 0.3s;
  }
  .nav-links a:hover { color: var(--accent); }
  .nav-links a:hover::after { width: 100%; }

  .nav-cta {
    background: transparent; border: 1px solid var(--accent);
    color: var(--accent); padding: 0.6rem 1.8rem;
    font-size: 0.8rem; letter-spacing: 2px; text-transform: uppercase;
    cursor: pointer; transition: all 0.3s;
    font-family: 'Inter', sans-serif;
  }
  .nav-cta:hover { background: var(--accent); color: var(--dark); }

  .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; background: none; border: none; }
  .hamburger span { width: 25px; height: 1.5px; background: var(--accent); transition: 0.3s; }

  /* HERO */
  .hero {
    min-height: 100vh; display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
    background:
      radial-gradient(ellipse at 30% 50%, rgba(107,39,55,0.25) 0%, transparent 60%),
      radial-gradient(ellipse at 70% 30%, rgba(212,165,116,0.1) 0%, transparent 50%),
      linear-gradient(180deg, var(--dark) 0%, var(--dark-2) 100%);
  }

  .hero-content {
    text-align: center; z-index: 2;
    animation: fadeUp 1.2s ease-out;
    padding: 2rem 1rem;
  }

  .hero-tag {
    display: inline-flex; align-items: center; gap: 0.8rem;
    font-size: 0.75rem; letter-spacing: 4px; text-transform: uppercase;
    color: var(--accent); margin-bottom: 2rem;
  }
  .hero-tag::before, .hero-tag::after {
    content: ''; width: 40px; height: 1px; background: var(--accent); opacity: 0.5;
  }

  .hero h1 {
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 300; line-height: 1.1;
    color: var(--cream);
    margin-bottom: 1.5rem;
  }
  .hero h1 em {
    font-style: italic; color: var(--accent);
    font-weight: 400;
  }

  .hero-sub {
    font-size: 1.05rem; color: var(--text-dim);
    max-width: 500px; margin: 0 auto 3rem;
    line-height: 1.8; letter-spacing: 0.5px;
  }

  .hero-btns { display: flex; gap: 1.2rem; justify-content: center; flex-wrap: wrap; }

  .btn-primary {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-deep) 100%);
    color: var(--dark);
    border: none; padding: 1rem 2.8rem;
    font-size: 0.8rem; letter-spacing: 3px; text-transform: uppercase;
    cursor: pointer; transition: all 0.4s;
    font-family: 'Inter', sans-serif; font-weight: 600;
    position: relative; overflow: hidden;
  }
  .btn-primary::before {
    content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    transition: left 0.5s;
  }
  .btn-primary:hover::before { left: 100%; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(212,165,116,0.35); }

  .btn-outline {
    background: transparent; color: var(--cream);
    border: 1px solid rgba(245,230,211,0.3); padding: 1rem 2.8rem;
    font-size: 0.8rem; letter-spacing: 3px; text-transform: uppercase;
    cursor: pointer; transition: all 0.4s;
    font-family: 'Inter', sans-serif;
  }
  .btn-outline:hover {
    border-color: var(--accent); color: var(--accent);
    transform: translateY(-2px);
  }

  .scroll-indicator {
    position: absolute; bottom: 2rem; left: 50%;
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
    animation: bounce 2s infinite;
  }
  .scroll-indicator span {
    font-size: 0.65rem; letter-spacing: 3px; text-transform: uppercase;
    color: var(--text-dim);
  }
  .scroll-line {
    width: 1px; height: 40px;
    background: linear-gradient(to bottom, var(--accent), transparent);
  }

  /* FLOATING ELEMENTS */
  .float-element {
    position: absolute; border-radius: 50%;
    background: radial-gradient(circle, rgba(212,165,116,0.15), transparent);
    animation: floatAnim 6s ease-in-out infinite;
    pointer-events: none;
  }
  .float-1 { width: 300px; height: 300px; top: 10%; left: -5%; animation-delay: 0s; }
  .float-2 { width: 200px; height: 200px; bottom: 20%; right: -3%; animation-delay: 2s; }
  .float-3 { width: 150px; height: 150px; top: 40%; right: 15%; animation-delay: 4s; }

  /* SECTION STYLES */
  section { padding: 7rem 4%; }

  .section-header { text-align: center; margin-bottom: 4rem; }
  .section-tag {
    font-size: 0.7rem; letter-spacing: 5px; text-transform: uppercase;
    color: var(--accent); margin-bottom: 1rem; display: block;
  }
  .section-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 300; color: var(--cream);
    margin-bottom: 1rem;
  }
  .section-title em { font-style: italic; color: var(--accent); }
  .section-line {
    width: 60px; height: 1px; background: var(--accent);
    margin: 1.5rem auto; opacity: 0.6;
  }
  .section-desc {
    color: var(--text-dim); max-width: 550px; margin: 0 auto;
    line-height: 1.8; font-size: 0.95rem;
  }

  /* ABOUT */
  .about { background: var(--dark-2); position: relative; }
  .about-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 5rem; max-width: 1200px; margin: 0 auto;
    align-items: center;
  }
  .about-visual {
    position: relative; height: 500px;
    border-radius: 4px; overflow: hidden;
  }
  .about-img {
    width: 100%; height: 100%;
    background:
      radial-gradient(ellipse at center, rgba(107,39,55,0.3) 0%, transparent 70%),
      linear-gradient(135deg, var(--brown) 0%, var(--dark) 100%);
    display: flex; align-items: center; justify-content: center;
    position: relative;
  }
  .about-img svg { width: 60%; opacity: 0.9; }
  .about-badge {
    position: absolute; bottom: 2rem; right: 2rem;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-deep) 100%);
    color: var(--dark);
    padding: 1.5rem; text-align: center;
    font-family: 'Playfair Display', serif;
  }
  .about-badge .num { font-size: 2.5rem; font-weight: 700; line-height: 1; }
  .about-badge .label { font-size: 0.65rem; letter-spacing: 2px; text-transform: uppercase; font-family: 'Inter', sans-serif; }

  .about-text h2 {
    font-size: 2.5rem; font-weight: 300; color: var(--cream);
    margin-bottom: 1.5rem; line-height: 1.3;
  }
  .about-text h2 em { font-style: italic; color: var(--accent); }
  .about-text p {
    color: var(--text-dim); line-height: 1.9; margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }
  .about-stats {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem; margin-top: 2.5rem;
    border-top: 1px solid rgba(212,165,116,0.2);
    padding-top: 2.5rem;
  }
  .stat-num {
    font-family: 'Playfair Display', serif;
    font-size: 2rem; color: var(--accent); font-weight: 700;
  }
  .stat-label {
    font-size: 0.7rem; letter-spacing: 2px; text-transform: uppercase;
    color: var(--text-dim); margin-top: 0.3rem;
  }

  /* MENU */
  .menu { background: var(--dark); }

  .menu-tabs {
    display: flex; justify-content: center; gap: 0.5rem;
    margin-bottom: 3.5rem; flex-wrap: wrap;
  }
  .menu-tab {
    background: transparent; border: 1px solid rgba(212,165,116,0.2);
    color: var(--text-dim); padding: 0.7rem 2rem;
    font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase;
    cursor: pointer; transition: all 0.3s;
    font-family: 'Inter', sans-serif;
  }
  .menu-tab.active, .menu-tab:hover {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-deep) 100%);
    color: var(--dark);
    border-color: var(--accent);
  }

  .menu-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem; max-width: 1200px; margin: 0 auto;
  }

  .menu-card {
    background: var(--dark-2);
    border: 1px solid rgba(212,165,116,0.1);
    border-radius: 4px; overflow: hidden;
    transition: all 0.5s; cursor: pointer;
    position: relative;
  }
  .menu-card:hover {
    transform: translateY(-8px);
    border-color: rgba(212,165,116,0.35);
    box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 40px rgba(107,39,55,0.15);
  }

  .menu-card-img {
    height: 240px; position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
  }
  .menu-card-img .img-bg {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    transition: transform 0.6s;
  }
  .menu-card:hover .img-bg { transform: scale(1.05); }

  .menu-card-img svg { width: 55%; max-width: 140px; opacity: 0.95; }

  .menu-card-body { padding: 1.8rem; }
  .menu-card-top {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 0.8rem;
  }
  .menu-card-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem; color: var(--cream); font-weight: 400;
  }
  .menu-card-price {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem; color: var(--accent); font-weight: 700;
  }
  .menu-card-desc {
    color: var(--text-dim); font-size: 0.85rem;
    line-height: 1.7; margin-bottom: 1.5rem;
  }
  .menu-card-btn {
    width: 100%; background: transparent;
    border: 1px solid rgba(212,165,116,0.3);
    color: var(--accent); padding: 0.8rem;
    font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase;
    cursor: pointer; transition: all 0.3s;
    font-family: 'Inter', sans-serif;
  }
  .menu-card-btn:hover {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-deep) 100%);
    color: var(--dark);
  }

  .menu-tag {
    position: absolute; top: 1rem; left: 1rem;
    background: linear-gradient(135deg, var(--wine) 0%, var(--wine-deep) 100%);
    color: var(--accent-light);
    padding: 0.35rem 0.9rem; font-size: 0.6rem;
    letter-spacing: 2px; text-transform: uppercase;
    font-weight: 600; z-index: 2;
    border: 1px solid rgba(212,165,116,0.3);
  }

  /* FEATURES */
  .features { background: var(--dark-2); }
  .features-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 2rem; max-width: 1200px; margin: 0 auto;
  }
  .feature-card {
    text-align: center; padding: 2.5rem 1.5rem;
    border: 1px solid rgba(212,165,116,0.1);
    border-radius: 4px; transition: all 0.4s;
    background: var(--dark);
    position: relative; overflow: hidden;
  }
  .feature-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0; transition: opacity 0.4s;
  }
  .feature-card:hover {
    border-color: rgba(212,165,116,0.3);
    transform: translateY(-5px);
  }
  .feature-card:hover::before { opacity: 1; }

  .feature-icon {
    width: 72px; height: 72px; margin: 0 auto 1.5rem;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(107,39,55,0.3) 0%, rgba(212,165,116,0.08) 70%);
    border: 1px solid rgba(212,165,116,0.25);
    position: relative;
  }
  .feature-icon::after {
    content: ''; position: absolute; inset: -4px;
    border-radius: 50%;
    border: 1px dashed rgba(212,165,116,0.2);
  }
  .feature-icon svg { width: 32px; height: 32px; }
  .feature-card h4 {
    font-size: 1.1rem; color: var(--cream);
    margin-bottom: 0.8rem; font-weight: 400;
  }
  .feature-card p {
    color: var(--text-dim); font-size: 0.85rem; line-height: 1.7;
  }

  /* TESTIMONIALS */
  .testimonials { background: var(--dark); }
  .test-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 2rem; max-width: 1100px; margin: 0 auto;
  }
  .test-card {
    padding: 2.5rem;
    border: 1px solid rgba(212,165,116,0.12);
    border-radius: 4px;
    background: var(--dark-2);
    transition: all 0.4s;
  }
  .test-card:hover { border-color: rgba(212,165,116,0.35); }
  .test-stars { color: var(--accent); font-size: 0.9rem; margin-bottom: 1.2rem; letter-spacing: 3px; }
  .test-text {
    color: var(--text); font-size: 0.95rem;
    line-height: 1.8; margin-bottom: 1.5rem;
    font-style: italic;
  }
  .test-author { display: flex; align-items: center; gap: 1rem; }
  .test-avatar {
    width: 45px; height: 45px; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--wine));
    display: flex; align-items: center; justify-content: center;
    font-family: 'Playfair Display', serif;
    color: var(--dark); font-weight: 700; font-size: 1.1rem;
    flex-shrink: 0;
  }
  .test-name { font-size: 0.9rem; color: var(--cream); }
  .test-role { font-size: 0.7rem; color: var(--text-dim); letter-spacing: 1px; }

  /* CTA */
  .cta {
    background:
      radial-gradient(ellipse at center, rgba(107,39,55,0.2) 0%, transparent 60%),
      var(--dark-2);
    text-align: center;
    padding: 8rem 4%;
  }
  .cta h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 300; color: var(--cream);
    margin-bottom: 1.5rem;
  }
  .cta h2 em { font-style: italic; color: var(--accent); }
  .cta p {
    color: var(--text-dim); max-width: 500px;
    margin: 0 auto 2.5rem; line-height: 1.8;
  }

  /* FOOTER */
  footer {
    background: var(--dark);
    border-top: 1px solid rgba(212,165,116,0.12);
    padding: 4rem 4% 2rem;
  }
  .footer-grid {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem; max-width: 1200px; margin: 0 auto;
    margin-bottom: 3rem;
  }
  .footer-brand .logo { margin-bottom: 1rem; display: inline-block; }
  .footer-brand p { color: var(--text-dim); font-size: 0.85rem; line-height: 1.8; max-width: 300px; }
  .footer-col h4 {
    font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase;
    color: var(--accent); margin-bottom: 1.5rem; font-family: 'Inter', sans-serif;
    font-weight: 600;
  }
  .footer-col a {
    display: block; color: var(--text-dim); text-decoration: none;
    font-size: 0.85rem; margin-bottom: 0.8rem; transition: color 0.3s;
  }
  .footer-col a:hover { color: var(--accent); }
  .footer-bottom {
    text-align: center; padding-top: 2rem;
    border-top: 1px solid rgba(212,165,116,0.1);
    color: var(--text-dim); font-size: 0.75rem;
    letter-spacing: 1px;
  }

  /* MODAL */
  .modal-overlay {
    position: fixed; inset: 0; z-index: 2000;
    background: rgba(0,0,0,0.8); backdrop-filter: blur(10px);
    display: none; align-items: center; justify-content: center;
    animation: fadeIn 0.3s;
  }
  .modal-overlay.active { display: flex; }
  .modal {
    background: var(--dark-2);
    border: 1px solid rgba(212,165,116,0.25);
    border-radius: 8px; padding: 3rem;
    max-width: 500px; width: 90%;
    position: relative;
    animation: slideUp 0.4s ease-out;
  }
  .modal-close {
    position: absolute; top: 1rem; right: 1rem;
    background: none; border: none; color: var(--text-dim);
    font-size: 1.5rem; cursor: pointer; transition: color 0.3s;
    width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
  }
  .modal-close:hover { color: var(--accent); }
  .modal h3 {
    font-size: 1.8rem; color: var(--cream); margin-bottom: 0.5rem;
  }
  .modal .modal-price {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem; color: var(--accent);
    margin-bottom: 1.5rem;
  }
  .modal p { color: var(--text-dim); line-height: 1.8; margin-bottom: 2rem; font-size: 0.9rem; }

  .size-options { display: flex; gap: 0.8rem; margin-bottom: 2rem; }
  .size-btn {
    flex: 1; padding: 0.8rem; text-align: center;
    border: 1px solid rgba(212,165,116,0.2);
    background: transparent; color: var(--text-dim);
    cursor: pointer; transition: all 0.3s;
    font-family: 'Inter', sans-serif; font-size: 0.75rem;
    letter-spacing: 1px; text-transform: uppercase;
  }
  .size-btn.active, .size-btn:hover {
    border-color: var(--accent); color: var(--accent);
    background: rgba(212,165,116,0.05);
  }
  .size-btn .size-price { display: block; font-size: 0.85rem; margin-top: 0.3rem; color: var(--accent); }

  /* NOTIFICATION */
  .notification {
    position: fixed; bottom: 2rem; right: 2rem;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-deep) 100%);
    color: var(--dark);
    padding: 1rem 2rem; border-radius: 4px;
    font-size: 0.85rem; font-weight: 600;
    transform: translateY(100px); opacity: 0;
    transition: all 0.4s; z-index: 3000;
    letter-spacing: 1px;
    box-shadow: 0 10px 30px rgba(212,165,116,0.3);
    max-width: 90vw;
  }
  .notification.show { transform: translateY(0); opacity: 1; }

  /* ANIMATIONS */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }
  @keyframes floatAnim {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-20px) scale(1.05); }
  }

  .reveal { opacity: 0; transform: translateY(40px); transition: all 0.8s ease-out; }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .features-grid { grid-template-columns: repeat(2, 1fr); }
    .test-grid { grid-template-columns: 1fr; max-width: 500px; }
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 768px) {
    .nav-links { display: none; }
    .nav-cta { display: none; }
    .hamburger { display: flex; }
    .about-grid { grid-template-columns: 1fr; gap: 3rem; }
    .about-visual { height: 350px; }
    .menu-grid { grid-template-columns: 1fr; }
    .features-grid { grid-template-columns: 1fr; }
    .footer-grid { grid-template-columns: 1fr; }
    .hero h1 { font-size: 2.8rem; }
    section { padding: 5rem 5%; }
  }

  /* Mobile menu */
  .mobile-menu {
    position: fixed; inset: 0; z-index: 1500;
    background: rgba(26,20,18,0.98);
    backdrop-filter: blur(20px);
    display: none; flex-direction: column;
    align-items: center; justify-content: center; gap: 2rem;
  }
  .mobile-menu.active { display: flex; }
  .mobile-menu a {
    color: var(--cream); text-decoration: none;
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem; transition: color 0.3s;
  }
