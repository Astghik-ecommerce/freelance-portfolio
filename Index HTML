<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Home Aroma Diffuser — Breathe. Relax. Live.</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/playfair-display@5.0.19/index.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5.0.16/index.min.css">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    --bg: #faf6f1;
    --bg-warm: #f3ebe0;
    --text: #1a1a1a;
    --muted: #6b6b6b;
    --accent: #c97b4a;
    --accent-dark: #a85f33;
    --sage: #7a8471;
    --line: #e5dfd4;
    --gold: #d4a574;
  }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Inter', sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    overflow-x: hidden;
  }
  h1, h2, h3, .serif { font-family: 'Playfair Display', serif; }

  /* NAV */
  #nav {
    position: absolute; top: 0; left: 0; right: 0;
    padding: 20px 48px;
    display: flex; justify-content: space-between; align-items: center;
    background: rgba(250, 246, 241, 0.85);
    backdrop-filter: blur(14px);
    z-index: 100;
    border-bottom: 1px solid transparent;
    transition: all .4s;
  }
  #nav.scrolled { border-bottom-color: var(--line); padding: 14px 48px; }
  .logo {
    font-family: 'Playfair Display', serif;
    font-size: 22px; font-weight: 600;
    letter-spacing: 1px;
    display: flex; align-items: center; gap: 8px;
  }
  .logo-icon {
    width: 32px; height: 32px;
    background: var(--accent);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 16px;
    animation: breathe 4s ease-in-out infinite;
  }
  @keyframes breathe {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.1); opacity: 0.85; }
  }
  .nav-links { display: flex; gap: 36px; }
  .nav-links a {
    text-decoration: none; color: var(--text);
    font-size: 14px; font-weight: 500;
    position: relative; transition: color .2s;
  }
  .nav-links a::after {
    content: ''; position: absolute;
    bottom: -4px; left: 0; width: 0; height: 1px;
    background: var(--accent); transition: width .3s;
  }
  .nav-links a:hover { color: var(--accent); }
  .nav-links a:hover::after { width: 100%; }
  .nav-cta {
    padding: 11px 24px; background: var(--text); color: var(--bg);
    border: none; font-size: 13px; font-weight: 500;
    letter-spacing: 1.5px; text-transform: uppercase;
    cursor: pointer; transition: all .3s;
    text-decoration: none; border-radius: 50px;
  }
  .nav-cta:hover { background: var(--accent); transform: translateY(-2px); }

  /* HERO */
  .hero {
    min-height: 100vh;
    display: grid; grid-template-columns: 1.1fr 1fr;
    align-items: center;
    padding: 120px 48px 60px;
    gap: 60px;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: ''; position: absolute;
    top: 20%; right: -10%;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(201, 123, 74, 0.12), transparent 70%);
    border-radius: 50%;
    animation: float 8s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-30px, 30px); }
  }
  .hero-content { max-width: 620px; position: relative; z-index: 2; }
  .hero-tag {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12px; letter-spacing: 3px; text-transform: uppercase;
    color: var(--accent); margin-bottom: 24px;
    padding: 8px 16px; background: rgba(201, 123, 74, 0.08);
    border-radius: 50px;
  }
  .hero-tag .dot {
    width: 6px; height: 6px; background: var(--accent);
    border-radius: 50%; animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }
  .hero h1 {
    font-size: clamp(44px, 5.8vw, 82px);
    line-height: 1.02; font-weight: 500;
    margin-bottom: 28px;
    letter-spacing: -1.5px;
  }
  .hero h1 em { font-style: italic; color: var(--accent); }
  .hero h1 .highlight {
    position: relative; display: inline-block;
  }
  .hero h1 .highlight::after {
    content: ''; position: absolute;
    bottom: 8px; left: 0; width: 100%; height: 8px;
    background: var(--gold); opacity: 0.3;
    z-index: -1;
  }
  .hero p {
    font-size: 18px; color: var(--muted);
    margin-bottom: 40px; max-width: 500px;
    line-height: 1.7;
  }
  .hero-actions { display: flex; gap: 16px; align-items: center; margin-bottom: 48px; }
  .btn-primary {
    padding: 18px 38px; background: var(--text); color: var(--bg);
    border: none; font-size: 13px; font-weight: 500;
    letter-spacing: 2px; text-transform: uppercase;
    cursor: pointer; transition: all .3s;
    text-decoration: none; display: inline-flex; align-items: center; gap: 10px;
    border-radius: 50px;
  }
  .btn-primary:hover { background: var(--accent); transform: translateY(-3px); box-shadow: 0 12px 30px rgba(201, 123, 74, 0.3); }
  .btn-secondary {
    padding: 18px 38px; background: transparent; color: var(--text);
    border: 1.5px solid var(--text); font-size: 13px; font-weight: 500;
    letter-spacing: 2px; text-transform: uppercase;
    cursor: pointer; transition: all .3s;
    text-decoration: none; border-radius: 50px;
  }
  .btn-secondary:hover { background: var(--text); color: var(--bg); }

  .hero-stats {
    display: flex; gap: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .stat-mini .num {
    font-family: 'Playfair Display', serif;
    font-size: 32px; color: var(--text);
    line-height: 1;
  }
  .stat-mini .lbl {
    font-size: 12px; color: var(--muted);
    letter-spacing: 1px; text-transform: uppercase;
    margin-top: 6px;
  }

  .hero-image {
    position: relative;
    height: 85vh;
    overflow: hidden;
    border-radius: 24px;
    box-shadow: 0 40px 80px rgba(0,0,0,0.15);
  }
  .hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 10s ease;
  }
  .hero-image:hover img { transform: scale(1.08); }
  .hero-price-tag {
    position: absolute;
    bottom: 30px; left: 30px;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(10px);
    padding: 16px 24px;
    border-radius: 16px;
    display: flex; align-items: center; gap: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }
  .hero-price-tag .price {
    font-family: 'Playfair Display', serif;
    font-size: 28px; color: var(--accent);
    font-weight: 600;
  }
  .hero-price-tag .label {
    font-size: 11px; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--muted);
  }
  .hero-price-tag .stars { color: #f5a623; font-size: 12px; }

  /* MARQUEE */
  .marquee {
    padding: 28px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    background: var(--bg-warm);
  }
  .marquee-track {
    display: flex; gap: 60px;
    animation: scroll 35s linear infinite;
    white-space: nowrap;
  }
  .marquee-item {
    font-family: 'Playfair Display', serif;
    font-size: 20px; font-style: italic;
    color: var(--muted);
    display: flex; align-items: center; gap: 60px;
  }
  .marquee-item::after {
    content: '✦'; color: var(--accent); font-style: normal;
  }
  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* SECTION HEADING */
  .section-head {
    text-align: center;
    padding: 120px 48px 60px;
    max-width: 800px; margin: 0 auto;
  }
  .section-head .eyebrow {
    font-size: 12px; letter-spacing: 3px; text-transform: uppercase;
    color: var(--accent); margin-bottom: 16px;
    display: inline-block;
  }
  .section-head h2 {
    font-size: clamp(38px, 4.5vw, 60px);
    font-weight: 500; letter-spacing: -1px;
    margin-bottom: 20px; line-height: 1.1;
  }
  .section-head p {
    color: var(--muted); font-size: 17px;
    line-height: 1.7;
  }

  /* PRODUCTS */
  .products {
    padding: 0 48px 120px;
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    max-width: 1400px; margin: 0 auto;
  }
  .product-card {
    cursor: pointer;
    position: relative;
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    transition: all .4s;
    border: 1px solid var(--line);
  }
  .product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 30px 60px rgba(0,0,0,0.1);
  }
  .product-img {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1/1;
    background: var(--bg-warm);
  }
  .product-img img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .8s ease;
  }
  .product-card:hover .product-img img { transform: scale(1.08); }
  .product-badge {
    position: absolute; top: 16px; left: 16px;
    background: var(--text); color: #fff;
    padding: 6px 14px;
    font-size: 10px; letter-spacing: 1.5px;
    text-transform: uppercase; font-weight: 600;
    border-radius: 50px;
  }
  .product-badge.sale { background: var(--accent); }
  .product-badge.new { background: var(--sage); }
  .product-wishlist {
    position: absolute; top: 16px; right: 16px;
    width: 40px; height: 40px;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(10px);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: all .3s;
    border: none; font-size: 16px;
  }
  .product-wishlist:hover { background: #fff; transform: scale(1.1); }
  .product-wishlist.active { color: #e74c3c; }
  .product-info {
    padding: 24px;
  }
  .product-info h3 {
    font-size: 20px; font-weight: 500;
    margin-bottom: 6px;
  }
  .product-info .cat {
    font-size: 12px; color: var(--muted);
    letter-spacing: 1px; text-transform: uppercase;
    margin-bottom: 14px;
  }
  .product-info .desc {
    font-size: 14px; color: var(--muted);
    margin-bottom: 18px; line-height: 1.6;
  }
  .product-bottom {
    display: flex; justify-content: space-between; align-items: center;
    padding-top: 18px; border-top: 1px solid var(--line);
  }
  .product-price {
    display: flex; align-items: baseline; gap: 8px;
  }
  .product-price .current {
    font-family: 'Playfair Display', serif;
    font-size: 24px; color: var(--accent);
    font-weight: 600;
  }
  .product-price .old {
    font-size: 14px; color: var(--muted);
    text-decoration: line-through;
  }
  .product-stars {
    color: #f5a623; font-size: 13px;
    display: flex; align-items: center; gap: 4px;
  }
  .product-stars span { color: var(--muted); font-size: 12px; margin-left: 4px; }
  .add-cart {
    padding: 10px 20px; background: var(--text); color: #fff;
    border: none; border-radius: 50px;
    font-size: 11px; letter-spacing: 1.5px;
    text-transform: uppercase; cursor: pointer;
    transition: all .3s; font-weight: 500;
  }
  .add-cart:hover { background: var(--accent); }

  /* FEATURES */
  .features {
    padding: 120px 48px;
    background: linear-gradient(180deg, var(--bg-warm) 0%, var(--bg) 100%);
  }
  .features-grid {
    max-width: 1400px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .feature {
    text-align: center;
    padding: 40px 24px;
    background: #fff;
    border-radius: 20px;
    transition: all .4s;
    border: 1px solid var(--line);
  }
  .feature:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.06);
    border-color: var(--accent);
  }
  .feature-icon {
    width: 72px; height: 72px;
    margin: 0 auto 24px;
    display: flex; align-items: center; justify-content: center;
    background: var(--bg-warm);
    border-radius: 50%;
    font-size: 28px;
    transition: all .4s;
  }
  .feature:hover .feature-icon {
    background: var(--accent);
    color: #fff;
    transform: rotate(360deg);
  }
  .feature h3 {
    font-size: 20px; margin-bottom: 12px;
    font-weight: 500;
  }
  .feature p {
    font-size: 14px; color: var(--muted);
    line-height: 1.7;
  }

  /* STORY */
  .story {
    display: grid; grid-template-columns: 1fr 1fr;
    min-height: 80vh;
    background: #fff;
  }
  .story-image {
    overflow: hidden;
    position: relative;
  }
  .story-image img {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .story-content {
    padding: 100px 80px;
    display: flex; flex-direction: column;
    justify-content: center;
  }
  .story-content .eyebrow {
    font-size: 12px; letter-spacing: 3px; text-transform: uppercase;
    color: var(--accent); margin-bottom: 20px;
  }
  .story-content h2 {
    font-size: clamp(32px, 3.5vw, 50px);
    font-weight: 500; margin-bottom: 28px;
    line-height: 1.15;
  }
  .story-content p {
    color: var(--muted); font-size: 16px;
    margin-bottom: 20px; max-width: 480px;
    line-height: 1.7;
  }
  .story-stats {
    display: flex; gap: 48px;
    margin-top: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  .stat .num {
    font-family: 'Playfair Display', serif;
    font-size: 44px; color: var(--accent);
    line-height: 1;
  }
  .stat .lbl {
    font-size: 12px; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--muted);
    margin-top: 8px;
  }

  /* REVIEWS */
  .reviews {
    padding: 120px 48px;
    background: var(--bg);
  }
  .reviews-container {
    max-width: 1400px; margin: 0 auto;
  }
  .reviews-header {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-bottom: 60px;
    flex-wrap: wrap; gap: 24px;
  }
  .reviews-header h2 {
    font-size: clamp(36px, 4vw, 54px);
    font-weight: 500; line-height: 1.1;
  }
  .reviews-summary {
    display: flex; align-items: center; gap: 20px;
  }
  .reviews-score {
    font-family: 'Playfair Display', serif;
    font-size: 56px; color: var(--accent);
    line-height: 1;
  }
  .reviews-meta .stars { color: #f5a623; font-size: 18px; margin-bottom: 4px; }
  .reviews-meta .count { font-size: 13px; color: var(--muted); }

  .reviews-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .review-card {
    background: #fff;
    padding: 32px;
    border-radius: 20px;
    border: 1px solid var(--line);
    transition: all .4s;
  }
  .review-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.06);
  }
  .review-head {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 16px;
  }
  .review-author {
    display: flex; align-items: center; gap: 12px;
  }
  .review-avatar {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-weight: 600; font-size: 16px;
  }
  .review-name { font-weight: 600; font-size: 15px; }
  .review-verified { font-size: 11px; color: var(--sage); display: flex; align-items: center; gap: 4px; }
  .review-stars { color: #f5a623; font-size: 14px; }
  .review-date { font-size: 12px; color: var(--muted); margin-top: 2px; }
  .review-text {
    font-size: 15px; color: var(--text);
    line-height: 1.7; margin-bottom: 16px;
  }
  .review-product {
    font-size: 12px; color: var(--muted);
    padding-top: 16px; border-top: 1px solid var(--line);
    letter-spacing: 0.5px;
  }

  /* FAQ */
  .faq {
    padding: 120px 48px;
    background: var(--bg-warm);
  }
  .faq-container {
    max-width: 900px; margin: 0 auto;
  }
  .faq-grid {
    display: grid; gap: 16px;
  }
  .faq-item {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    transition: all .3s;
  }
  .faq-item:hover { border-color: var(--accent); }
  .faq-item.active {
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    border-color: var(--accent);
  }
  .faq-question {
    padding: 24px 28px;
    display: flex; justify-content: space-between; align-items: center;
    cursor: pointer;
    gap: 20px;
  }
  .faq-question h4 {
    font-size: 17px; font-weight: 500;
    font-family: 'Inter', sans-serif;
  }
  .faq-toggle {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--bg-warm);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: all .3s;
    font-size: 18px;
    color: var(--accent);
  }
  .faq-item.active .faq-toggle {
    background: var(--accent);
    color: #fff;
    transform: rotate(45deg);
  }
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height .4s ease, padding .4s ease;
  }
  .faq-item.active .faq-answer {
    max-height: 300px;
  }
  .faq-answer-inner {
    padding: 0 28px 24px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }

  /* CTA */
  .cta {
    padding: 120px 48px;
    background: var(--text);
    color: var(--bg);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .cta::before {
    content: ''; position: absolute;
    top: -50%; left: 50%; transform: translateX(-50%);
    width: 800px; height: 800px;
    background: radial-gradient(circle, rgba(201, 123, 74, 0.2), transparent 70%);
    border-radius: 50%;
  }
  .cta-content { position: relative; z-index: 2; }
  .cta h2 {
    font-size: clamp(38px, 4.5vw, 64px);
    font-weight: 500; margin-bottom: 20px;
    line-height: 1.1;
  }
  .cta p {
    color: rgba(255,255,255,0.7); margin-bottom: 40px;
    font-size: 17px; max-width: 520px; margin-left: auto; margin-right: auto;
  }
  .newsletter {
    display: flex; max-width: 500px; margin: 0 auto;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 50px;
    padding: 6px;
  }
  .newsletter input {
    flex: 1; padding: 14px 24px;
    border: none; background: transparent;
    font-size: 15px; font-family: inherit;
    outline: none; color: #fff;
  }
  .newsletter input::placeholder { color: rgba(255,255,255,0.5); }
  .newsletter button {
    padding: 14px 28px;
    background: var(--accent); color: #fff;
    border: none; border-radius: 50px;
    font-size: 13px; letter-spacing: 1.5px;
    text-transform: uppercase; font-weight: 500;
    cursor: pointer; transition: all .3s;
  }
  .newsletter button:hover { background: var(--accent-dark); transform: translateY(-1px); }

  /* FOOTER */
  footer {
    background: #0f0f0f; color: var(--bg);
    padding: 80px 48px 32px;
  }
  .footer-grid {
    max-width: 1400px; margin: 0 auto;
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 60px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .footer-brand p {
    color: rgba(255,255,255,0.6); font-size: 14px;
    max-width: 300px; margin-top: 16px;
  }
  .footer-col h4 {
    font-size: 12px; letter-spacing: 2px;
    text-transform: uppercase; margin-bottom: 20px;
    color: var(--accent);
  }
  .footer-col a {
    display: block; color: rgba(255,255,255,0.7);
    text-decoration: none; font-size: 14px;
    margin-bottom: 12px; transition: color .2s;
  }
  .footer-col a:hover { color: var(--accent); }
  .footer-bottom {
    max-width: 1400px; margin: 0 auto;
    padding-top: 32px;
    display: flex; justify-content: space-between;
    font-size: 12px; color: rgba(255,255,255,0.5);
    flex-wrap: wrap; gap: 12px;
  }

  /* ANIMATIONS */
  .fade-up {
    opacity: 0; transform: translateY(40px);
    transition: opacity .8s ease, transform .8s ease;
  }
  .fade-up.visible { opacity: 1; transform: translateY(0); }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .products { grid-template-columns: repeat(2, 1fr); }
    .features-grid { grid-template-columns: repeat(2, 1fr); }
    .reviews-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    #nav { padding: 16px 24px; }
    .nav-links { display: none; }
    .hero { grid-template-columns: 1fr; padding: 100px 24px 40px; gap: 40px; }
    .hero-image { height: 60vh; }
